@Library("MysharedLibrary") _
pipeline {
    agent any 
    stages{
        stage("hello") {
            steps{
                helloWorld()
            }
        }
        stage("code fetch") {
            steps{
                git branch: 'master', url: 'https://github.com/SivasaiReddy2379/Learning.git'
            }
        }
        stage("BuildImage") {
            steps{
                sh 'docker build -f EmployeeDockerFile -t employeeimg:v1 .'
            }
        }
        stage("RunApplication") {
            steps{
                sh 'docker run -itd --name employee -p 2222:8081 employeeimg:v1'
            }
        }
    }
}
