@Library('Shared-Library') _
pipeline {
    agent any

    tools {
        gradle 'mygradle'
    }

    stages {
        stage('Hello') {
            steps {
                helloWorld()
            }
        }
        stage('Code Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/SivasaiReddy2379/Learning.git'
            }
        }

        stage('Build') {
            steps {
                dir('employee-management') {
                    gradleBuild()
                }
            }
        }

        stage('Run') {
            steps {
                dir('employee-management') {
                    sh '''
                    nohup java -jar build/libs/employee-management-0.0.1-SNAPSHOT.jar \
                    --server.port=8081 > app.log 2>&1 &
                    '''
                }
            }
        }
    }
}

