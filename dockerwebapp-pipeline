pipeline {
    agent {
        node {
            label 'dev'
        }
    }

    tools {
        maven 'mymaven'
    }

    stages {

        stage('Code Fetch') {
            steps {
                git branch: 'master', url: 'https://github.com/SivasaiReddy2379/dockerwebapp.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqubeserver') {
                    sh 'mvn clean verify sonar:sonar -Dsonar.projectKey=devopsproject1'
                }
            }
        }

        stage('Build using Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }
        stage('Build images') {
            steps {
                sh 'docker build -t sivasaireddy2379/db:v1 Docker-db'
                sh 'docker build -f AppDockerFile -t sivasaireddy2379/app:v1 .'
            }
        }
        stage('Image scan') {
            steps {
                sh 'trivy image sivasaireddy2379/db:v1'
                sh 'trivy image sivasaireddy2379/app:v1'
            }
        }
        stage('Push images to docker hub') {
            steps {
                withDockerRegistry(credentialsId: 'dockerhubpass') {
                    sh 'docker push sivasaireddy2379/app:v1'
                    sh 'docker push sivasaireddy2379/db:v1'
                }
            }
        }
        stage('deploy c') {
            steps {
                sh 'docker stack deploy -c compose.yml myapp'
            }
        }
    }
}
