pipeline {
    agent {
        node {
            label 'dev'
        }
    }

    tools {
        maven 'mymaven'
    }

    stages {

        stage('Code Fetch') {
            steps {
                git branch: 'master', url: 'https://github.com/SivasaiReddy2379/dockerwebapp.git'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn clean verify sonar:sonar -Dsonar.projectKey=devopsproject1'
                }
            }
        }
        stage('Code build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }
        stage('artifact') {
            steps {
                nexusArtifactUploader artifacts: [[artifactId: 'vprofile', classifier: '', file: 'target/vprofile-v2.war', type: 'war']], credentialsId: 'nexus', groupId: 'com.visualpathit', nexusUrl: '54.146.189.108:8081', nexusVersion: 'nexus3', protocol: 'http', repository: 'myrepo', version: 'v2'
            }
        }
        stage('Image Build') {
            steps {
                sh 'docker run --privileged --rm tonistiigi/binfmt --install all'
                sh 'docker buildx inspect multiarch >/dev/null 2>&1 || docker buildx create --name multiarch --driver docker-container --use'
                sh 'docker buildx build --platform linux/amd64 -t sivasaireddy2379/mysql:v1 Docker-db --load'
                sh 'docker buildx build --platform linux/arm64,linux/amd64 -f Docker-app/Dockerfile -t sivasaireddy2379/javaapp:v1 . --load'
            }
        }
        stage('Image scan') {
            steps {
                sh 'trivy image -f table -o trivy-sqlreport.txt sivasaireddy2379/mysql:v1'
                sh 'trivy image -f table -o trivy-javareport.txt sivasaireddy2379/javaapp:v1'
            }
        }
        stage('Push images to docker hub') {
            steps {
                script {
                     withDockerRegistry(credentialsId: 'docker') {
                        sh 'docker push sivasaireddy2379/javaapp:v1'
                        sh 'docker push sivasaireddy2379/mysql:v1'
                }
                }
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker stack deploy -c compose.yml myapp'
            }
        }
        
    }
}
